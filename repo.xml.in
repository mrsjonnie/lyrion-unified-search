<?xml version="1.0" encoding="utf-8"?>
<!--
    LMS custom repository descriptor.
    Add this URL in LMS Settings > Plugins > Additional Repositories:
    https://raw.githubusercontent.com/mrsjonnie/lyrion-unified-search/main/repo.xml
-->
<extensions>
    <details>
        <title lang="EN">Lyrion LMS Add-ons</title>
        <title lang="NL">Lyrion LMS-add-ons</title>
    </details>
    <plugins>
        <plugin
            name="UnifiedSearch"
            version="UNIFIED_VERSION"
            target="unix|mac|windows"
            minTarget="8.0"
            maxTarget="*"
            sha="GENERATED_UNIFIED_SHA1"
            url="https://github.com/mrsjonnie/lyrion-unified-search/releases/download/vUNIFIED_VERSION/UnifiedSearch-UNIFIED_VERSION.zip"
            category="musicservices"
            creator="mrsjonnie"
        >
            <title lang="EN">Lyrion Unified Search</title>
            <title lang="NL">Lyrion Unified Search</title>
            <desc lang="EN">Unified Search entry in Material Applications and Default Browse menus, with local library and SpotOn results</desc>
            <desc lang="NL">Unified Search in Toepassingen van Material en in Bladeren van Default, met resultaten uit de lokale bibliotheek en SpotOn</desc>
        </plugin>
        <plugin
            name="DefaultLogoHome"
            version="LOGO_VERSION"
            target="unix|mac|windows"
            minTarget="8.0"
            maxTarget="*"
            sha="GENERATED_LOGO_SHA1"
            url="https://github.com/mrsjonnie/lyrion-unified-search/releases/download/vUNIFIED_VERSION/DefaultLogoHome-LOGO_VERSION.zip"
            category="interface"
            creator="mrsjonnie"
        >
            <title lang="EN">Default Logo → LMS Home</title>
            <title lang="NL">Default-logo → LMS-startpagina</title>
            <desc lang="EN">Makes the Lyrion logo in the Default skin open the LMS home page</desc>
            <desc lang="NL">Laat het Lyrion-logo in de Default-skin de LMS-startpagina openen</desc>
        </plugin>
    </plugins>
</extensions>
