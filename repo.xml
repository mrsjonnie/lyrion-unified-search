<?xml version="1.0" encoding="utf-8"?>
<!--
    LMS custom repository descriptor for Lyrion Unified Search.

    Add the published raw URL in LMS Settings > Plugins > Additional Repositories:
    https://raw.githubusercontent.com/mrsjonnie/lyrion-unified-search/main/repo.xml

    The release workflow fills in the version, release URL and SHA-1 digest.
-->
<extensions>
    <details>
        <title lang="EN">Lyrion Unified Search Repository</title>
        <title lang="NL">Lyrion Unified Search Repository</title>
    </details>
    <plugins>
        <plugin
            name="UnifiedSearch"
            version="0.1.1"
            target="unix|mac|windows"
            minTarget="8.0"
            maxTarget="*"
            sha="fb6219fe0a3979763d7bd01a716eab0cccd3d915"
            url="https://github.com/mrsjonnie/lyrion-unified-search/releases/download/v0.1.1/UnifiedSearch-0.1.1.zip"
            category="musicservices"
            creator="mrsjonnie"
        >
            <title lang="EN">Lyrion Unified Search</title>
            <title lang="NL">Lyrion Unified Search</title>
            <desc lang="EN">Grouped search entry for the LMS library, YouTube and SpotOn</desc>
            <desc lang="NL">Gecombineerde zoekingang voor de LMS-bibliotheek, YouTube en SpotOn</desc>
        </plugin>
    </plugins>
</extensions>
